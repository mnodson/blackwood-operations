# Deployed config for Cloud Functions. Fill in the Stripe price ids once the
# products exist, then `npm run deploy:functions`.
APP_ORIGIN=https://blackwoodops.com

# One-time prices for the document update ($395 / $995 / $2,795).
STRIPE_PRICE_ESSENTIAL=price_1ULZyi3mr3ZJYThajxWqXHE6
STRIPE_PRICE_PRACTICE=price_1ULZyc3mr3ZJYThaEMWAxQGh
STRIPE_PRICE_GROUP=price_1ULZyW3mr3ZJYThaVGbm7f2K

# Recurring monthly prices for the optional monitoring add-on ($39 / $99 / $299).
STRIPE_PRICE_ESSENTIAL_MONITORING=price_1ULZyf3mr3ZJYTha5taDovUb
STRIPE_PRICE_PRACTICE_MONITORING=price_1ULZyZ3mr3ZJYThaiRfBxJ4P
STRIPE_PRICE_GROUP_MONITORING=price_1ULZyR3mr3ZJYThaUcUCxrCR

# Order emails are sent through Resend. The sender's domain must be verified
# in Resend. The API key is a secret: firebase functions:secrets:set RESEND_API_KEY
ORDER_FROM_EMAIL="Blackwood Operations <admin@blackwoodops.com>"
# Who gets the internal new-order email (customer details + notice download link).
ORDER_NOTIFY_EMAIL=admin@blackwoodops.com
# Reply-to on the customer's order confirmation.
ORDER_REPLY_TO_EMAIL=admin@blackwoodops.com

# Stripe customer portal login link, emailed to monitoring customers so they can
# update their card or cancel. Mirrors src/app/shared/billing.ts.
BILLING_PORTAL_URL=https://billing.stripe.com/p/login/dRm9AMghp3Pk2yb4SG9R600
